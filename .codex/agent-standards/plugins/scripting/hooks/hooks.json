{
  "description": "After a shell script is written or edited, format it with shfmt and hold it to strict mode and shellcheck.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/lint_shell.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
